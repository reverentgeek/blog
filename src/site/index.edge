---
layout: layouts/default.edge
pagination:
  data: collections.posts
  size: 10
  alias: posts
  reverse: true
computed:
  title: '{{ pagination.pageNumber ? "Posts, Page " + (pagination.pageNumber + 1) : "Home" }}'
  description: '{{ pagination.pageNumber ? site.description + ". Page " + (pagination.pageNumber + 1) + " of " + pagination.pages.length + "." : "" }}'
---

    {{-- Page 1 only: pages 2+ are just more of the post list. --}}
    @if(pagination.pageNumber === 0)
      <section class="home-intro">
        <div class="home-intro-top">
          {{-- The image transform wraps this in <picture>, so the sizing lives on
               a wrapper the flex layout can measure. No `width` attribute: it would
               override the widths list and emit a single 1x file, which is what made
               this avatar blurry on retina. 2x/3x capped at the 256px source. --}}
          <div class="home-intro-avatar-wrap">
            <img class="home-intro-avatar" src="{{ site.logo }}" alt="An illustrated avatar of David Neal" loading="eager" decoding="async" ssqch:widths="64,96,192,256" sizes="(min-width: 640px) 96px, 64px">
          </div>
          <div class="min-w-0">
            <h1 class="home-intro-heading">Hi, I'm David Neal.</h1>
            <p class="home-intro-text">Illustrator, builder, and DevRel leader, helping folks in tech be more awesome.</p>
            {{-- The avatar doubles as a product sample, so this line is a commission pitch. --}}
            <p class="home-intro-caption"><span class="hand-note hand-note-drew"><span class="ink ink-arrow-curve" aria-hidden="true"></span><span class="ink ink-note-i-drew-this" aria-hidden="true"></span><span class="sr-only">I drew this avatar.</span></span> <a href="/avatars/" data-cta="view-avatars">I can draw you, too.</a></p>
          </div>
        </div>

        <div class="about-paths">
          <div class="callout callout-commission">
            <span class="callout-label">Illustration</span>
            <div class="callout-content">
              <p>Avatars, stickers, logos, mascots, and book illustrations, drawn by a developer who gets the joke.</p>
              <a class="callout-button" href="/commissions/" data-cta="start-commission">Hire me to illustrate</a>
            </div>
          </div>
          <div class="callout callout-devrel">
            <span class="callout-label">Developer Relations</span>
            <div class="callout-content">
              <p>Developer programs, content, code, and workshops that developers trust and leadership can measure.</p>
              <a class="callout-button" href="/devrel/" data-cta="view-devrel">Work with me on DevRel</a>
            </div>
          </div>
        </div>
      </section>

      <section class="home-work" aria-labelledby="home-work-heading">
        <h2 class="home-section-heading" id="home-work-heading">Selected work</h2>
        <div class="home-work-list">
          <a class="home-work-item" href="/avatars/" data-cta="home-work-avatars">
            <img class="home-work-contain" src="/content/images/featured/avatars-sample.jpg" alt="Three illustrated avatars: a woman with pink hair and glasses in color, a smiling man in black and white, and a woman with long purple braids in color" loading="lazy" ssqch:widths="192,320,640" sizes="(min-width: 896px) 270px, (min-width: 640px) 33vw, 96px">
            <span class="home-work-title">Avatars</span>
            <span class="home-work-text">Thousands drawn for developers, teams, and conferences.</span>
          </a>
          <a class="home-work-item" href="https://github.com/reverentgeek/inkleaf" data-cta="home-work-inkleaf">
            <img src="/content/images/featured/inkleaf-screenshot.png" alt="Inkleaf, a desktop notes app, showing a note and search results" loading="lazy" ssqch:widths="192,320,640" sizes="(min-width: 896px) 270px, (min-width: 640px) 33vw, 96px">
            <span class="home-work-title">Inkleaf</span>
            <span class="home-work-text">An open-source notes app with MongoDB hybrid and vector search.</span>
          </a>
          <a class="home-work-item" href="/developer-relations-activity-patterns/" data-cta="home-work-book">
            <img src="/content/images/announcing-devrel-activity-patterns-book/devrel-activity-patterns.jpg" alt="The cover of Developer Relations Activity Patterns" loading="lazy" ssqch:widths="192,320,640" sizes="(min-width: 896px) 270px, (min-width: 640px) 33vw, 96px">
            <span class="home-work-title">Developer Relations Activity Patterns</span>
            <span class="home-work-text">The DevRel book I co-wrote and illustrated.</span>
          </a>
        </div>
      </section>

      <div class="home-section-header" id="latest-writing">
        <h2 class="home-section-heading has-marker"><span class="ink ink-pencil" aria-hidden="true"></span>Latest writing</h2>
        <p class="home-section-links"><a href="/topics/">Topics</a> &middot; <a href="/archive/">Archive</a> &middot; <a href="/feed.xml">RSS</a></p>
      </div>
    @end

    <section class="post-list">
        @each((post, index) in posts)
			@!component('components/card', { post: post, eager: index === 0 && pagination.pageNumber !== 0 })
        @end
    </section>

    @include('partials/pagination')

    @if(pagination.pageNumber === 0)
      @!component('components/book-strip', { books: books })
    @end
