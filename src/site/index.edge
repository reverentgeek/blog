---
layout: layouts/default.edge
pagination:
  data: collections.posts
  size: 10
  alias: posts
  reverse: true
computed:
  title: '{{ pagination.pageNumber ? "Posts, Page " + (pagination.pageNumber + 1) : "Home" }}'
  description: '{{ pagination.pageNumber ? site.description + ". Page " + (pagination.pageNumber + 1) + " of " + pagination.pages.length + "." : "" }}'
---

    {{-- Page 1 only — pages 2+ are just more of the post list. --}}
    @if(pagination.pageNumber === 0)
      <section class="home-intro">
        {{-- The image transform wraps this in <picture>, so the sizing lives on
             a wrapper the flex layout can measure. --}}
        {{-- The avatar doubles as a product sample, so its caption is a commission pitch. --}}
        <figure class="home-intro-figure">
          <div class="home-intro-avatar-wrap">
            {{-- The wrap is 80px, growing to 96px at sm. No `width` attribute: it would
                 override the widths list and emit a single 1x file, which is what made
                 this avatar blurry on retina. 2x/3x capped at the 256px source. --}}
            <img class="home-intro-avatar" src="{{ site.logo }}" alt="An illustrated avatar of David Neal" loading="eager" decoding="async" ssqch:widths="96,192,256" sizes="(min-width: 640px) 96px, 80px">
          </div>
          <figcaption class="home-intro-caption">I drew this. <a href="/avatars/" data-cta="view-avatars">I can draw you, too.</a></figcaption>
        </figure>
        <div>
          <h1 class="home-intro-heading">Hi, I'm David Neal.</h1>
          <p class="home-intro-text">
            I'm an illustrator, builder, and DevRel leader, helping folks in tech be more awesome.
            I draw avatars, stickers, logos, and books for developers, authors, and tech companies,
            and I help teams build developer programs that developers trust.
          </p>
          <div class="home-intro-actions">
            <a class="cta-button" href="/commissions/" data-cta="start-commission">Hire me to illustrate</a>
            <a class="cta-button" href="/devrel/" data-cta="view-devrel">Work with me on DevRel</a>
          </div>
          <p class="home-intro-links">
            Or <a href="/topics/">browse posts by topic</a>, <a href="/feed.xml">subscribe via RSS</a>, or read <a href="/about/">more about me</a>.
          </p>
        </div>
      </section>

      @!component('components/book-strip', { books: books })
    @end

    <section class="post-list">
        @each((post, index) in posts)
			@!component('components/card', { post: post, eager: index === 0 && pagination.pageNumber === 0 })
        @end
    </section>

    @include('partials/pagination')
