---
permalink: '_headers'
---

/feed.xml
  content-type: application/atom+xml; charset=UTF-8

/.well-known/webfinger
  content-type: application/jrd+json; charset=UTF-8

# Each page's Markdown copy (llmsPlugin()), for agents: a second version of the page,
# which a search engine shouldn't list beside it. The edge function in
# netlify/edge-functions/markdown.js sets its own headers.
/*.md
  X-Robots-Tag: noindex
  Content-Type: text/markdown; charset=utf-8

# Security headers, for Netlify
# https://docs.netlify.com/routing/headers/

/*
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

# Image derivatives have content-hashed filenames, safe to cache forever
/img/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Fingerprinted assets (index.<hash>.css, index.<hash>.js, pco.<hash>.js) are safe to
# cache forever: changing the contents changes the filename, so browsers fetch the new
# URL immediately instead of sitting on a stale copy. This lives here rather than in
# netlify.toml so Cloudflare applies it too.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
