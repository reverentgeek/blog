<!DOCTYPE html>
<html lang="{{ site.lang }}" class="no-js">

<head>
  @include('partials/head')

  {{-- Resource hints for better performance --}}
  <link rel="preconnect" href="https://www.googletagmanager.com">
  <link rel="dns-prefetch" href="https://www.google-analytics.com">
  <link rel="dns-prefetch" href="https://giscus.app">

  {{-- Preload critical fonts (discovered late via CSS otherwise) --}}
  <link rel="preload" href="/fonts/Roboto-Regular.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/Roboto-Bold.woff2" as="font" type="font/woff2" crossorigin>

  {{-- Preload hero banner image on homepage for better LCP --}}
  @if(page.url === '/' && heroImage)
  <link rel="preload" as="image"
    href="{{ heroImage.preload.href }}"
    type="{{ heroImage.preload.type }}"
    fetchpriority="high"
    imagesrcset="{{ heroImage.preload.imagesrcset }}"
    imagesizes="{{ heroImage.sizes }}">
  @end

  <link rel="stylesheet" href="{{ assets.css }}" />
  <script src="{{ assets.js }}" defer></script>

  <script>document.documentElement.classList.remove('no-js');</script>

