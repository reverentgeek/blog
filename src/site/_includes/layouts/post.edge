---
layout: layouts/default.edge
---
  @let(postTopics = topicsOnly(tags))
  <article class="content page-{{ slug }}">
    <h1 class="text-4xl font-bold mt-4">{{ title }}</h1>
    <div class="post-meta text-gray-500 uppercase text-sm mb-4">
      {{ postDate(date) }}
      &middot;
      {{ readingTime(content) }} min read
    </div>
    @if(feature_image)
      <figure class="post-feature-image">
        <img
          eleventy:widths="600,900,1200,1500"
          fetchpriority="high"
          src="{{ feature_image }}"
          alt="{{ title }}"
          sizes="(min-width: 1280px) 1200px, 100vw"
          loading="eager"
          decoding="async">
      </figure>
    @end
    <section class="content-body">
      {{{ content }}}
    </section>

    @if(postTopics.length)
      <nav class="post-topics" aria-label="Topics">
        <span class="text-gray-500 uppercase text-sm">Topics</span>
        @each(topic in postTopics)
          @!component('components/topic-chip', { slug: topic })
        @end
      </nav>
    @end

    @!component('components/support', { kofiLink: site.kofi })

    @let(nav = adjacentPosts(collections.posts, page.url))
    @if(nav.older || nav.newer)
      <nav class="post-nav" aria-label="More posts">
        @if(nav.older)
          <a class="post-nav-link" href="{{ nav.older.url }}">
            <span class="post-nav-label">&larr; Older post</span>
            <span class="post-nav-title">{{ nav.older.data.title }}</span>
          </a>
        @else
          <div></div>
        @end
        @if(nav.newer)
          <a class="post-nav-link post-nav-next" href="{{ nav.newer.url }}">
            <span class="post-nav-label">Newer post &rarr;</span>
            <span class="post-nav-title">{{ nav.newer.data.title }}</span>
          </a>
        @end
      </nav>
    @end

    <div id="comments" class="giscus mt-8"></div>
    <script>
      (function () {
        var target = document.getElementById("comments");
        if (!target) return;
        var loaded = false;
        var loadGiscus = function () {
          if (loaded) return;
          loaded = true;
          var s = document.createElement("script");
          s.src = "https://giscus.app/client.js";
          s.setAttribute("data-repo", "{{ site.giscus.repo }}");
          s.setAttribute("data-repo-id", "{{ site.giscus.repoId }}");
          s.setAttribute("data-category", "{{ site.giscus.category }}");
          s.setAttribute("data-category-id", "{{ site.giscus.categoryId }}");
          s.setAttribute("data-mapping", "{{ site.giscus.mapping }}");
          s.setAttribute("data-strict", "0");
          s.setAttribute("data-reactions-enabled", "{{ site.giscus.reactionsEnabled }}");
          s.setAttribute("data-emit-metadata", "0");
          s.setAttribute("data-input-position", "{{ site.giscus.inputPosition }}");
          s.setAttribute("data-theme", "{{ site.giscus.theme }}");
          s.setAttribute("data-lang", "{{ site.lang }}");
          s.setAttribute("data-loading", "lazy");
          s.crossOrigin = "anonymous";
          s.async = true;
          target.appendChild(s);
        };
        var observer = new IntersectionObserver(function (entries) {
          if (entries[0].isIntersecting) {
            observer.disconnect();
            loadGiscus();
          }
        }, { rootMargin: "200px" });
        observer.observe(target);
      })();
    </script>
    <noscript>Please enable JavaScript to view the comments.</noscript>
    @include('partials/legacy-comments')

  </article>

  {{-- Load Prism.js for syntax highlighting on blog posts --}}
  <script src="{{ assets.prism }}" defer></script>
