{{--
  One link per card. The title anchor is stretched over the whole card via a
  ::after overlay (see .post-link in styles.css), so the image and description
  are clickable without being separate links a screen reader has to repeat.
--}}
<article class="post">
  <div class="post-card flex flex-wrap items-start">
    @if(post.data.feature_image)
      <div class="w-full py-4 lg:py-0 lg:w-1/3 lg:mb-0">
        <img
          class="post-thumb"
          eleventy:widths="300,600"
          src="{{ post.data.feature_image }}"
          alt=""
          sizes="(min-width: 1024px) 300px, 90vw"
          loading="{{ eager ? 'eager' : 'lazy' }}"
          {{{ eager ? 'fetchpriority="high"' : '' }}}
          decoding="async">
      </div>
    @else
      <div class="hidden lg:block lg:w-1/3"></div>
    @end
    <div class="w-full lg:w-2/3 lg:pl-4">
      <h2 class="post-title">
        <a class="post-link" href="{{ post.url }}">{{ post.data.title }}</a>
      </h2>
      <div class="post-date">{{ postDate(post.data.date) }}</div>
      <p class="post-description">{{ post.data.description }}</p>
    </div>
  </div>
</article>
