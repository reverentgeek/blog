<header class="px-5 sm:px-6 py-2 bg-rgblue/75 flex flex-wrap items-center lg:px-8 xl:px-16">
  @include('partials/navigation')
</header>
@if(page.url === '/')
  {{-- Full width on phones; from sm up, the collage matches the content column below it,
       which keeps it about 300px tall on desktop instead of 480px. --}}
  {{-- The page's largest paint: ssqch:preload puts a preload for its AVIF srcset in <head> and
       loads it eagerly with fetchpriority="high". The sizes match .home-hero: full width on
       phones, at most 832px (the content column) from 896px up. --}}
  <div class="home-hero">
    <img
      class="w-full"
      ssqch:preload
      src="{{ site.cover_image }}"
      sizes="(min-width: 896px) 832px, 100vw"
      alt="Site banner image with a collage of illustrations and doodles. The center image is the ReverentGeek logo with a speech bubble that reads, you don't need permission to be awesome.">
  </div>
@end
