@if(pagination.previousPageHref || pagination.nextPageHref)
  <nav class="flex flex-col items-center gap-4" role="navigation" aria-label="Pagination Navigation">
    <div class="flex flex-row justify-center items-center">
      @if(pagination.previousPageHref)
        <a class="bg-action hover:bg-action-hover text-white font-bold mx-2 py-2 px-4 rounded-lg transition-colors duration-200" href="{{ pagination.previousPageHref }}">
          <span class="hidden sm:inline">Prev page</span>
          <span class="sm:hidden">&larr;</span>
        </a>
      @else
        <span class="bg-gray-200 text-gray-600 font-bold mx-2 py-2 px-4 rounded-lg cursor-not-allowed" aria-disabled="true">
          <span class="hidden sm:inline">Prev page</span>
          <span class="sm:hidden">&larr;</span>
        </span>
      @end

      <span class="mx-4 text-gray-600 font-medium">
        Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}
      </span>

      @if(pagination.nextPageHref)
        <a class="bg-action hover:bg-action-hover text-white font-bold mx-2 py-2 px-4 rounded-lg transition-colors duration-200" href="{{ pagination.nextPageHref }}">
          <span class="hidden sm:inline">Next page</span>
          <span class="sm:hidden">&rarr;</span>
        </a>
      @else
        <span class="bg-gray-200 text-gray-600 font-bold mx-2 py-2 px-4 rounded-lg cursor-not-allowed" aria-disabled="true">
          <span class="hidden sm:inline">Next page</span>
          <span class="sm:hidden">&rarr;</span>
        </span>
      @end
    </div>
  </nav>
@end
