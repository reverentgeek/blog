{{-- Shared <head> metadata: title, SEO, canonical, feed, Open Graph, Twitter, and JSON-LD --}}
@let(seoDescription = meta_description || description || site.description)
{{-- Social cards use a 1200px PNG copy of the page's image (ssqch's imageUrl), which every
     network can show. --}}
@let(seoImageData = imageUrl(site.cover_image, { width: 1200, format: 'png' }))
@let(seoArticleAuthor = site.author ? site.author.url : site.url)
@let(seoAuthorLink = site.author ? site.author.url : '')

@if(feature_image)
  @assign(seoImageData = imageUrl(feature_image, { width: 1200, format: 'png' }))
  @assign(seoArticleAuthor = site.url)
@end

@let(seoImage = seoImageData.url.startsWith('http') ? seoImageData.url : site.url + seoImageData.url)
@let(displayTitle = title ? title + ' – ' + site.title : site.title)
@let(seoImageAlt = title || site.title)
@let(seoOgType = date ? 'article' : 'website')
  <meta charset="utf-8">
  <title>
@if(title)~
{{ title }} – {{ site.title }}
@else~
{{ site.title }} – {{ site.description }}
@end~
  </title>
  <meta name="description" content="{{ seoDescription }}">
  {{-- `noindex: true` in front matter keeps a page out of search (pair it with `sitemap: false`). --}}
  <meta name="robots" content="{{ noindex ? 'noindex,follow' : 'index,follow' }}">
  <meta name="generator" content="{{ ssqch.generator }}">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="canonical" href="{{ site.url + page.url }}" />
  <link rel="alternate" type="application/atom+xml" title="Atom Feed for {{ site.title }}"
    href="{{ site.url }}/feed.xml" />
  {{-- For agents: the page as Markdown, and the site's map (llmsPlugin() in ssqch.config.js). --}}
  @let(markdownCopyUrl = markdownCopy(page.url))
  @if(markdownCopyUrl)
  <link rel="alternate" type="text/markdown" href="{{ markdownCopyUrl }}" />
  @end
  <link rel="describedby" href="/llms.txt" />
  @if(site.icon)
  <link rel="icon" type="image/x-icon" href="{{ site.icon }}" />
  @end

  <!-- Open Graph -->
  <meta property="og:url" content="{{ site.url + page.url }}">
  <meta property="og:type" content="{{ seoOgType }}">
  <meta property="og:title" content="{{ displayTitle }}">
  <meta property="og:description" content="{{ seoDescription }}">
  <meta property="og:image" content="{{ seoImage }}">
  <meta property="og:image:alt" content="{{ seoImageAlt }}">
  <meta property="og:image:width" content="{{ seoImageData.width }}">
  <meta property="og:image:height" content="{{ seoImageData.height }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="article:author" content="{{ seoArticleAuthor }}">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="{{ site.twitter }}">
  <meta name="twitter:creator" content="{{ site.twitter }}">
  <meta name="twitter:title" content="{{ displayTitle }}">
  <meta name="twitter:description" content="{{ seoDescription }}">
  <meta name="twitter:image" content="{{ seoImage }}">
  <meta name="twitter:image:alt" content="{{ seoImageAlt }}">

  <!-- Schema -->
  @if(seoAuthorLink)
  <link rel="author" href="{{ seoAuthorLink }}">
  @end

  {{-- JSON-LD structured data for blog posts --}}
  @if(date && tags && tags.includes('posts'))
  <script type="application/ld+json">
  {{{ jsonLdArticle({ title, description: seoDescription, image: seoImage, datePublished: htmlDateString(date), author: site.author, publisher: { name: site.title, logoUrl: site.url + imageUrl(site.logo).url }, pageUrl: site.url + page.url }) }}}
  </script>
  @end
