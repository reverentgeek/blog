{
	"name": "blog",
	"version": "1.3.2",
	"description": "The ReverentGeek Blog, built with SiteSquatch",
	"scripts": {
		"clean": "node scripts/clean.js",
		"clean:all": "rimraf dist",
		"serve:css": "postcss src/assets/css/styles.css --output dist/assets/index.css --watch",
		"serve:js": "esbuild src/assets/js/index.js --bundle --outdir=dist/assets --watch",
		"serve:site": "scripts/ssqch.sh serve",
		"serve": "run-s clean serve:site",
		"build:css": "postcss src/assets/css/styles.css --output dist/assets/index.css --no-map",
		"build:js": "esbuild src/assets/js/index.js --bundle --outdir=dist/assets --minify",
		"build:site": "scripts/ssqch.sh build --env production",
		"build:prune": "node scripts/prune-images.js",
		"build": "NODE_ENV=production run-s clean build:css build:js build:site build:prune",
		"start": "pnpm run serve",
		"lint": "eslint . --ext .cjs --ext .js --cache",
		"lint:markdown": "markdownlint src/**/*.md",
		"page": "node src/utils/content.js page",
		"post": "node src/utils/content.js post",
		"test": "pnpm run test:smoke",
		"test:smoke": "pnpm run build && node --test test/smoke.test.js",
		"test:lighthouse": "lighthouse --view https://reverentgeek.com --output html --output-path ./reports/report.html",
		"test:lighthouse:local": "pnpm run build && node scripts/lighthouse-local.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/reverentgeek/blog.git"
	},
	"engines": {
		"node": ">=24"
	},
	"keywords": [
		"sitesquatch",
		"static",
		"site",
		"jamstack",
		"reverentgeek",
		"blog"
	],
	"author": "David Neal",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/reverentgeek/blog/issues"
	},
	"homepage": "https://github.com/reverentgeek/blog#readme",
	"type": "module",
	"dependencies": {
		"@tailwindcss/postcss": "^4.3.5",
		"esbuild": "^0.28.2",
		"npm-run-all2": "^9.0.4",
		"postcss": "^8.5.32",
		"postcss-cli": "^12.0.0",
		"postcss-import": "^17.0.1",
		"rimraf": "^6.1.4",
		"tailwindcss": "^4.3.5"
	},
	"devDependencies": {
		"commander": "^15.1.0",
		"eslint": "^10.14.0",
		"eslint-config-reverentgeek": "^7.1.27",
		"jimp": "^1.6.1",
		"lighthouse": "^13.6.0",
		"markdownlint-cli": "~0.50.0",
		"netlify-plugin-cache": "^1.0.3",
		"probe-image-size": "^7.5.0",
		"sharp": "^0.35.5",
		"slug": "^12.0.1",
		"uuid": "^14.0.3"
	},
	"packageManager": "pnpm@12.19.0+sha512.87327b6619853205834e4be59ba3a231e303d9f5e435912ede3312b7539b79af890942f6513b05a4690745666888045c09b33fc420c2cd2d3bd95c01ba21dbeb"
}
